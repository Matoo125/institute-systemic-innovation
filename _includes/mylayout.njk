---
title: Inštitút systémových inovácií
---
<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8">
    <script>
      // Apply the theme before first paint to avoid a flash.
      // Saved choice wins; otherwise follow the system, defaulting to dark.
      (function () {
        try {
          var saved = localStorage.getItem("theme");
          var prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
          var theme = saved || (prefersLight ? "light" : "dark");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="description" content="Inštitút systémových inovácií prepája prax, dáta a použiteľné riešenia pre verejné, občianske, regionálne aj súkromné prostredie.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel='stylesheet' href='https://cdn-uicons.flaticon.com/4.0.0/uicons-regular-straight/css/uicons-regular-straight.css'>
    <link rel='stylesheet' href='https://cdn-uicons.flaticon.com/4.0.0/uicons-regular-rounded/css/uicons-regular-rounded.css'>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/gridjs@6.2.0/dist/theme/mermaid.min.css">
    <link rel="stylesheet" href="/bundle.css?v={{ assetVersion }}">

  </head>
  <body>
    <a class="skip-link" href="#content">Preskočiť na obsah</a>
    <header class="site-header">
      <nav class="site-nav" aria-label="Hlavná navigácia">
        <a class="site-brand" href="/" aria-label="Inštitút systémových inovácií">
          <span class="site-brand__mark">ISI</span> 
          <span class="site-brand__text">Systémové Inovácie</span>
        </a>
        <button class="site-nav__toggle" type="button" aria-label="Otvoriť navigáciu" aria-controls="site-nav-links" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <div class="site-nav__links" id="site-nav-links">
          <a href="/inovacie/">Inovácie</a>
          <a href="/digitalizacia/">Digitalizácia</a>
          <a href="/prieskumy/">Prieskumy a analýzy</a>
          <a href="/o-nas/">Inštitút a vedenie </a>
          <a href="/konzultacia/">Konzultácia</a>
          <a href="/kontakt/">Kontakt</a>
          <a href="/ui/">UI</a>
        </div>
      </nav>
    </header>
    <main id="content">
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <span class="site-footer__brand">Inštitút Systémových Inovácií</span>
        <span class="site-footer__tagline">Systémovo, Odborne, Prakticky</span>
        <span class="site-footer__year">2026</span>
      </div>
    </footer>
    <script>
      const nav = document.querySelector(".site-nav");
      const navToggle = document.querySelector(".site-nav__toggle");
      const navLinks = document.querySelector(".site-nav__links");

      if (nav && navToggle && navLinks) {
        const setNavOpen = (isOpen) => {
          nav.classList.toggle("is-open", isOpen);
          navToggle.setAttribute("aria-expanded", String(isOpen));
          navToggle.setAttribute("aria-label", isOpen ? "Zatvoriť navigáciu" : "Otvoriť navigáciu");
        };

        navToggle.addEventListener("click", () => {
          setNavOpen(!nav.classList.contains("is-open"));
        });

        navLinks.addEventListener("click", (event) => {
          if (event.target.closest("a")) {
            setNavOpen(false);
          }
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            setNavOpen(false);
          }
        });
      }

      // Theme toggle — flips data-theme and remembers the choice.
      const themeToggle = document.querySelector(".theme-toggle");
      if (themeToggle) {
        const syncToggle = () => {
          const isLight = document.documentElement.getAttribute("data-theme") === "light";
          themeToggle.setAttribute("aria-pressed", String(isLight));
        };
        syncToggle();

        themeToggle.addEventListener("click", () => {
          const next = document.documentElement.getAttribute("data-theme") === "light" ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", next);
          try { localStorage.setItem("theme", next); } catch (e) { /* no-op */ }
          syncToggle();
        });
      }
    </script>
    <script src="/assets/info-tooltip.js?v={{ assetVersion }}" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/gridjs@6.2.0/dist/gridjs.umd.js"></script>
    <script src="/assets/data-table.js?v={{ assetVersion }}" defer></script>
  </body>
</html>
